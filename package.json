{
  "name": "slack2md",
  "version": "1.1.0",
  "description": "Copy selected Slack messages as Markdown",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt -b firefox",
    "build": "wxt build -b firefox",
    "zip": "wxt zip -b firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "check": "oxlint . && vitest run",
    "postinstall": "wxt prepare"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "spawn-sync"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "happy-dom": "^20.7.0",
    "oxlint": "^1.50.0",
    "vitest": "^4.0.18",
    "wxt": "^0.20.18"
  }
}
